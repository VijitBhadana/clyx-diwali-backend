PORT=4000
# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# Public base URL used to build photo links
PUBLIC_URL=http://localhost:4000

# Supabase (leave blank to fall back to local data/*.json + uploads/)
SUPABASE_URL=
# Secret / service_role key: server only, never put it in the frontend
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres (IPv4 session pooler), only needed to run supabase/schema.sql
DATABASE_URL=
